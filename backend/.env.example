# GourMate (ChefSight) backend configuration.
# Copy to `.env` and fill in real values locally. Never commit real secrets.

# --- Brain (REQUIRED, secret, server-side only) ---
# Never expose this to the browser. Set on Fly via `fly secrets set GEMINI_API_KEY=...`.
GEMINI_API_KEY=

# Gemini model id used for conversation, recipe generation and parsing.
GEMINI_MODEL=gemini-3.5-flash-lite
# Per-request Gemini timeout in seconds.
GEMINI_TIMEOUT_S=30

# --- Speech-to-text (faster-whisper) ---
# Model size. `small.en` (English-only) is the accuracy default for the final
# pass. Changing this re-downloads weights (small.en ~460 MB).
WHISPER_MODEL=small.en
# Decoding beam width. `1` is greedy decoding: the fastest final pass; higher is
# more accurate but slower.
WHISPER_BEAM_SIZE=1
WHISPER_COMPUTE_TYPE=int8_float32
# Live partial captions are disabled (streaming partials were unreliable and the
# UI shows no live user text). Only the accurate final pass runs.
WHISPER_PARTIAL_ENABLED=false
STREAMING_STT_ENABLED=false
WHISPER_PARTIAL_MODEL=small.en
PARTIAL_INTERVAL_S=0.25
# Full assistant: Gemini intake/conversation + tools + edge-tts. Set true to
# transcribe only (no reply), e.g. for STT debugging.
TRANSCRIPTION_ONLY=false
STREAMING_STT_REPO=csukuangfj/sherpa-onnx-streaming-zipformer-en-2023-06-26
STREAMING_STT_NUM_THREADS=1
WHISPER_HOTWORDS=adobo, sinigang, pancit, lechon, tinola, kaldereta, Filipino, tablespoon, teaspoon, simmer, saute, garlic, butter, olive oil, chicken, salmon, pasta, rice
# Culinary vocabulary/units/numbers bias (comma list, no markdown). Uncomment to
# override the built-in default prompt; leave commented to use the default.
# WHISPER_INITIAL_PROMPT=Kitchen voice commands and recipe instructions. Units: tablespoon, teaspoon, cup, ounce, gram, pound.
# Model cache directory. On Fly.io this is the persistent volume.
HF_HOME=/data/hf
# Speech gate: reject utterances shorter than this (seconds) before Whisper so
# short/quiet clips cannot trigger a hallucination.
STT_MIN_UTTERANCE_S=0.15
# Speech gate: reject utterances quieter than this level in dBFS (negative;
# silence floors at -120). Audio above this RMS floor still requires peak >= 0.02.
STT_MIN_RMS_DBFS=-120
# Silence (seconds) that must follow speech before VAD finalizes the utterance.
# Higher = more forgiving of mid-sentence pauses but delays the final transcript.
VAD_MIN_SILENCE_S=0.6
# After a pause, wait this long for speech to resume before transcribing; resumed
# speech is appended to the same utterance instead of a fragmented new turn.
UTTERANCE_CONTINUATION_S=0.4

# --- Rate limits / caps (spec RL-1..RL-5) ---
# REST token bucket for /api/recipes/* (requests per minute per IP + burst).
REST_RATE_LIMIT=10
REST_RATE_BURST=5
# Minimum seconds between finalized turns in one session (RL-2).
SESSION_MIN_TURN_GAP_S=1.5
# Max seconds per utterance (RL-3). Reaching the cap forces a flush.
MAX_UTTERANCE_S=120
# Max seconds retained in the in-memory ring buffer (RL-3) before eviction.
MAX_BUFFER_S=60
# Global daily ceiling of Gemini calls (RL-4).
GEMINI_DAILY_CAP=500
# Per-IP WebSocket cap (RL-5). A same-IP reconnect performs a newest-wins
# takeover: the previous socket is closed (1000) and replaced, so a browser
# reload never collides with its own still-closing socket.
WS_MAX_CONNECTIONS_PER_IP=4
# Process-global WebSocket ceiling across all IPs (protects the process from a
# distributed flood that dodges the per-IP cap). Unlike the per-IP cap this is a
# hard limit: the new connection is closed with 1013 when reached.
WS_MAX_TOTAL_CONNECTIONS=200
# Max bytes accepted in a single binary audio frame (input cap; ~80 ms @16k mono).
WS_MAX_FRAME_BYTES=8192
# Max characters accepted for a pasted/dictated recipe (input cap).
MAX_RECIPE_TEXT_CHARS=20000
# Max characters treated as a "pure navigation" utterance before falling back to Gemini.
NAV_MAX_CHARS=80
# Recent chat turns mirrored server-side per session.
CHAT_HISTORY_WINDOW=12

# --- CORS / WS origin allowlist (comma-separated) ---
# Include both `localhost` and `127.0.0.1`: a browser may use either for the
# same Vite dev server, and a mismatch closes the WS with 1008.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://gourmate.vercel.app

# --- Proxy trust ---
# Trust a client-supplied `x-forwarded-for` header (rightmost hop) as the client
# IP. Leave false for a bare deployment; enabling it without a trusted proxy
# lets clients spoof their IP and bypass per-IP caps. Fly.io deployments may
# leave this false: the edge always injects the non-spoofable `fly-client-ip`
# header, which is honored regardless of this setting.
TRUST_PROXY_HEADERS=false

# --- Audio transport ---
AUDIO_SAMPLE_RATE=16000

# --- Text-to-speech (edge-tts) ---
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
# Per-sentence synthesis timeout in seconds. On expiry the turn degrades to
# text-only with a `tts_failed` event instead of wedging on a hung synth.
TTS_TIMEOUT_S=15

# --- Logging ---
LOG_LEVEL=INFO
